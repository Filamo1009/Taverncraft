{
  "name": "taverncraft-cloudflare-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && wrangler deploy --dry-run --env=\"\" --outdir dist",
    "check": "tsc --noEmit && wrangler types --check",
    "dev": "wrangler dev --local",
    "migration:prepare": "node scripts/prepare-migration.mjs",
    "migration:upload": "node scripts/upload-migration.mjs",
    "secrets:generate": "node scripts/generate-auth-secrets.mjs",
    "test": "vitest run",
    "types": "wrangler types worker-configuration.d.ts",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  }
}
